<?xml version="1.0" encoding="utf-8"?>
<!-- Runder Glasknopf in der linken Leiste; gewählt = blau gefüllt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="@color/accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/surface2" /><stroke android:width="1dp" android:color="@color/glassLine" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/glass" /><stroke android:width="1dp" android:color="@color/glassLine" /></shape>
    </item>
</selector>
