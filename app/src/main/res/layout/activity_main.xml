<?xml version="1.0" encoding="utf-8"?>
<!--
  Cockpit „Military Tactical“ im Querformat (Art-Direction und Prototyp vom 22.11.2026).
  - links: Leiste (Ansicht, Einpassen, System, Copilot, Protokoll, Einstellungen), gefüllt in cockpit/Cockpit.kt
  - Mitte: Bildfläche (Livebild | Karte | 3D), darüber das HUD mit Status- und Warnzeile und den drei Flugwerten
  - rechts: Aktionsfeld (Plan, Fortschritt, Startprüfung, Hauptknopf, STOP)
  - systemRoot: System-Bildschirm, liegt über Bildfläche und Aktionsfeld
  - vollbildHost: was im Vollbild über der Ansicht bleibt (Leiste, Aktionsfeld und HUD sind dann ausgeblendet)
  Die Ränder (Statusleiste, Notch, Navigationsleiste) legt MainActivity.applyInsets auf overlayRoot.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/overlayRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/rahmen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="6dp"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/rail"
                android:layout_width="@dimen/rail"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <FrameLayout
                android:id="@+id/mitte"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:id="@+id/liveRoot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <FrameLayout
                        android:id="@+id/stage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/stage_frame"
                        android:padding="1dp">

                        <SurfaceView
                            android:id="@+id/video"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <org.osmdroid.views.MapView
                            android:id="@+id/map"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <WebView
                            android:id="@+id/view3d"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <FrameLayout
                            android:id="@+id/hudHost"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/videoHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginStart="75dp"
                            android:layout_marginBottom="36dp"
                            android:background="@drawable/stage_frame"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/text"
                            android:textSize="12dp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.06"
                            android:typeface="monospace"
                            android:text="No live view" />

                        <!-- Vollbild: Verlassen, kleine Wertezeile, kleiner STOP (cockpit/Vollbild.kt) -->
                        <FrameLayout
                            android:id="@+id/vollbildHost"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/panel"
                        android:layout_width="@dimen/panelWidth"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/systemRoot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Sprechen mit Central Command: runder Knopf und Streifen über jeder Ansicht und Fläche (cockpit/Sprechen.kt) -->
                <FrameLayout
                    android:id="@+id/sprechHost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
