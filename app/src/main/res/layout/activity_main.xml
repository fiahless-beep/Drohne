<?xml version="1.0" encoding="utf-8"?>
<!--
  Cockpit im Querformat. Karte oder Livebild füllen den ganzen Bildschirm, darüber liegen Glasflächen:
  - oben: Verbindung · Phase · GPS/Akku/Sensoren/Wind
  - links: Leiste (Karte|Video, Karte einpassen, Protokoll, Mehr)
  - unten links: Telemetrie (Höhe, Abstand, Tempo)
  - rechts: Aktionsfeld (Plan, Startprüfung, Hauptknopf, STOPP)
  Die Ränder (Statusleiste, Notch, Navigationsleiste) werden in MainActivity.applyInsets auf overlayRoot gelegt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <WebView
        android:id="@+id/view3d"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/videoHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/textMuted"
        android:textSize="14sp"
        android:text="Kein Livebild" />

    <FrameLayout
        android:id="@+id/overlayRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Obere Leiste -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="@dimen/edge"
            android:layout_marginEnd="@dimen/edge"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/linkDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/linkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:text="Getrennt" />

            <TextView
                android:id="@+id/phase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView android:id="@+id/chipGps" style="@style/Chip" android:text="GPS –" />
            <TextView android:id="@+id/chipBattery" style="@style/Chip" android:text="–" />
            <TextView android:id="@+id/chipSensors" style="@style/Chip" android:text="" />
            <TextView android:id="@+id/chipWind" style="@style/Chip" android:text="" />
        </LinearLayout>

        <!-- Linke Leiste -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/edge"
            android:orientation="vertical">
            <ImageView android:id="@+id/btnMap" style="@style/RailButton" android:layout_marginTop="0dp" android:src="@drawable/ic_map" android:contentDescription="Karte" />
            <ImageView android:id="@+id/btnVideo" style="@style/RailButton" android:src="@drawable/ic_video" android:contentDescription="Livebild" />
            <ImageView android:id="@+id/btn3d" style="@style/RailButton" android:src="@drawable/ic_cube" android:contentDescription="3D" />
            <ImageView android:id="@+id/btnCenter" style="@style/RailButton" android:layout_marginTop="22dp" android:src="@drawable/ic_center" android:contentDescription="Karte einpassen" />
            <ImageView android:id="@+id/btnLog" style="@style/RailButton" android:src="@drawable/ic_list" android:contentDescription="Protokoll" />
            <ImageView android:id="@+id/btnMore" style="@style/RailButton" android:src="@drawable/ic_more" android:contentDescription="Mehr" />
        </LinearLayout>

        <!-- Telemetrie unten links -->
        <TextView
            android:id="@+id/telemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/edge"
            android:background="@drawable/pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="" />

        <!-- Aktionsfeld rechts -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="@dimen/panelWidth"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="68dp"
            android:layout_marginEnd="@dimen/edge"
            android:layout_marginBottom="@dimen/edge"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/planName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Kein Plan" />

            <TextView
                android:id="@+id/planMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/textMuted"
                android:textSize="13sp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Plan holen oder Testflug" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/surface2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nextAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/checklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPrimary" style="@style/Btn.Primary" android:text="Plan holen" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secondaryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPlan" style="@style/Btn" android:layout_marginEnd="4dp" android:text="Testflug" />
                <Button android:id="@+id/btnFollow" style="@style/Btn" android:layout_marginStart="4dp" android:text="Folgen" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/btnHome" style="@style/Btn.Stop" android:text="STOPP · Heimflug" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
