<resources>
    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="Btn" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#455A64</item>
    </style>
    <style name="Btn.Primary"><item name="android:backgroundTint">#1565C0</item></style>
    <style name="Btn.Go"><item name="android:backgroundTint">#2E7D32</item></style>
    <style name="Btn.Stop"><item name="android:backgroundTint">#C62828</item><item name="android:textSize">18sp</item><item name="android:layout_height">56dp</item></style>
</resources>
